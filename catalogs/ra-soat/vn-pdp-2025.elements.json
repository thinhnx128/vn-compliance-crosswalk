{
  "_note": "Yếu tố kiểm được cho 22 yêu cầu VN-PDP (nội dung yêu cầu, căn cứ, loại lấy từ vn-pdp-2025.requirements.json cùng thư mục; căn cứ pháp lý đối chiếu bản Công báo ngày 13/11/2026). Mẫu (patterns) là bộ chấm theo luật: mỗi phương án là danh sách biểu thức phải cùng khớp trong MỘT đoạn; khớp một phương án là có bằng chứng. topic: dấu hiệu bộ văn bản có nói tới chủ đề (để phân biệt 'Chưa' với 'Không đủ thông tin'). Không phân biệt hoa thường.",
  "catalog_version": "0.1.0",
  "requirements": {
    "VN-PDP-01": {
      "topic": [
        "bảo vệ (DLCN|dữ liệu cá nhân)",
        "DPO"
      ],
      "elements": [
        {
          "id": "e1",
          "text": "Chỉ định bộ phận hoặc nhân sự bảo vệ dữ liệu cá nhân (hoặc thuê dịch vụ bảo vệ dữ liệu cá nhân)",
          "patterns": [
            [
              "(bộ phận|nhân sự)[^.|]{0,20}bảo vệ (DLCN|dữ liệu cá nhân)",
              "chỉ định|đảm nhiệm|phụ trách"
            ],
            [
              "thuê (tổ chức|cá nhân)[^.|]{0,30}dịch vụ bảo vệ"
            ]
          ]
        },
        {
          "id": "e2",
          "text": "Chính sách bảo vệ dữ liệu cá nhân được lãnh đạo phê duyệt",
          "patterns": [
            [
              "phê duyệt",
              "chính sách"
            ]
          ]
        }
      ]
    },
