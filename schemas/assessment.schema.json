{
  "$defs": {
    "ControlState": {
      "additionalProperties": false,
      "properties": {
        "applicable": {
          "default": true,
          "title": "Applicable",
          "type": "boolean"
        },
        "justification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lý do áp dụng / không áp dụng",
          "title": "Justification"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImplementationStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "due": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "ControlState",
      "type": "object"
    },
    "ImplementationStatus": {
      "enum": [
        "implemented",
        "partial",
        "planned",
        "not_implemented"
      ],
      "title": "ImplementationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "assessment",
      "default": "assessment",
      "title": "Kind",
      "type": "string"
    },
    "organization": {
      "title": "Organization",
      "type": "string"
    },
    "scope": {
      "title": "Scope",
      "type": "string"
    },
    "catalog": {
      "title": "Catalog",
      "type": "string"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "level": {
      "anyOf": [
        {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Cấp độ HTTT được đánh giá; lọc control theo thẻ cap-do-N",
      "title": "Level"
    },
    "controls": {
      "additionalProperties": {
        "$ref": "#/$defs/ControlState"
      },
      "title": "Controls",
      "type": "object"
    }
  },
  "required": [
    "organization",
    "scope",
    "catalog",
    "as_of"
  ],
  "title": "Assessment",
  "type": "object",
  "$id": "https://github.com/thinhnx128/vn-compliance-crosswalk/schemas/assessment.schema.json"
}
