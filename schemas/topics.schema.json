{
  "$defs": {
    "Topic": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "Topic",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "topics",
      "default": "topics",
      "title": "Kind",
      "type": "string"
    },
    "topics": {
      "items": {
        "$ref": "#/$defs/Topic"
      },
      "title": "Topics",
      "type": "array"
    }
  },
  "required": [
    "topics"
  ],
  "title": "Topics",
  "type": "object",
  "$id": "https://github.com/thinhnx128/vn-compliance-crosswalk/schemas/topics.schema.json"
}
